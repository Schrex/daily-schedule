{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "daily-schedule",
  // The script (worker/src/app.ts) answers every request first: it serves the
  // pages under /daily-schedule/ (where the hub forwards them) and, on the old
  // address, at the root. Later the API under /daily-schedule/api/.
  "main": "worker/src/app-index.ts",
  "compatibility_date": "2026-11-10",
  // No workers.dev address: the old one (daily-schedule.schrex.workers.dev) is
  // switched off, so the app is reached only through the hub, at
  // app.schreiberexcavating.com/daily-schedule/. PR previews keep their own
  // address (.github/scripts/preview-config.mjs).
  "workers_dev": false,
  // The hub's Supabase sign-in: the Worker checks each request's token against
  // the keys published here (worker/src/signIn.ts). Sign-in only, never data.
  "vars": {
    "HUB_AUTH_URL": "https://acgqjjbrnkmeazswdnzp.supabase.co/auth/v1"
  },
  "observability": {
    "enabled": true
  },
  // The Roster, the Daily Schedules and the access list. The schema is in
  // migrations/ (applied by CI before each deploy; see the README).
  // Its name is "daily-schedule": use that in every command and in the
  // dashboard. "DB" is only what the code calls it (env.DB).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "daily-schedule",
      "database_id": "ce405ebb-eeac-4ea4-88c0-6cc22aa8b79b",
      "migrations_dir": "migrations"
    }
  ],
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": true,
    // An address that isn't one of the pages gets public/404.html with a 404,
    // never the board.
    "not_found_handling": "404-page"
  }
}
